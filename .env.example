# Optional local overrides. Production uses the public Supabase configuration in src/lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only ClickHouse analytics connection. Never prefix these with NEXT_PUBLIC_.
# Use the HTTPS endpoint shown in ClickHouse Cloud -> Connect (normally port 8443).
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=pricing_analytics

# Server-only OpenAI connection for conversational MGP Intelligence.
# Never prefix these with NEXT_PUBLIC_. The Responses API is called only from Vercel server routes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Shared secret for /api/internal worker routes. Send it as x-mgp-internal-token
# or x-chilexpress-worker-token. Plain token or SHA-256 hex are accepted.
INTERNAL_WORKER_TOKEN=
